# CQUPT AI Assistant — Environment Variables
# Copy this file to .env and fill in your values
#   cp .env.example .env

# Required: Doubao (Volcano Ark) API credentials
DOUBAO_API_KEY=sk-your-api-key-here
DOUBAO_MODEL=your-model-id
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-251215

# Required: JWT secret for auth (change in production)
JWT_SECRET=change-me-in-production

# Optional
LOG_LEVEL=INFO
